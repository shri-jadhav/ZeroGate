# ==============================================================================
# ZeroGate Cloud - Local Development Environment Variables
# ==============================================================================
# Copy this file to .env and configure local development values.
# NEVER commit .env to version control.
# ==============================================================================

# Keycloak Administrator Credentials (master realm bootstrap)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ReplaceWithStrongMasterAdminPassword123!

# PostgreSQL Database Credentials for Keycloak
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=ReplaceWithStrongPostgresPassword123!

# OpenID Connect Client Secrets (for oauth2-proxy)
GRAFANA_CLIENT_SECRET=ReplaceWithGrafanaClientSecret32BytesHex
GITEA_CLIENT_SECRET=ReplaceWithGiteaClientSecret32BytesHex

# oauth2-proxy Cookie Secrets (must be exactly 16, 24, or 32 bytes)
GRAFANA_COOKIE_SECRET=ReplaceWith32ByteCookieSecretKey!
GITEA_COOKIE_SECRET=ReplaceWith32ByteCookieSecretKey!

# Internal Application Admin Passwords
GRAFANA_ADMIN_PASSWORD=ReplaceWithStrongGrafanaAdminPassword123!
GITEA_ADMIN_PASSWORD=ReplaceWithStrongGiteaAdminPassword123!

# Synthetic Test User Passwords (conforms to realm password policy: min 12 chars, upper, lower, digit, special)
TEST_USER_PASSWORD=ZeroGate@2026Pass!

# ==============================================================================
# Phase 2: Network Security & Wazuh SIEM Variables
# ==============================================================================
SQUID_PORT=3128
UNBOUND_PORT=1053
WAZUH_MANAGER_HOST=127.0.0.1
WAZUH_SYSLOG_PORT=514

